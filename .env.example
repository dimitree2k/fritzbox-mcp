# Fritz!Box MCP Server - Environment Variables
# Copy to .env and fill in your values

FRITZBOX_HOST=192.168.178.1
FRITZBOX_SCHEME=http
FRITZBOX_USER=your_fritzbox_username
# Optional: leave this out to read the password from the OS keyring instead
# (uv run --extra keyring keyring set fritzbox-mcp <FRITZBOX_USER>)
FRITZBOX_PASSWORD=your_fritzbox_password
